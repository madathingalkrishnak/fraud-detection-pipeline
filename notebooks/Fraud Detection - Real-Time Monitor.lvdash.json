    {
      "name": "b0793bf4",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `fraud_detection`;\n",
        "USE SCHEMA `transactions`;\n",
        "\n",
        "-- Top flagged cards (card-level risk profile)\n",
        "SELECT\n",
        "    card_id,\n",
        "    COUNT(*) AS total_txns,\n",
        "    SUM(predicted_fraud) AS fraud_flags,\n",
        "    ROUND(AVG(fraud_score), 3) AS avg_risk_score,\n",
        "    ROUND(SUM(amount), 2) AS total_spend,\n",
        "    COUNT(DISTINCT country) AS unique_countries\n",
        "FROM fraud_detection.transactions.scored_transactions\n",
        "GROUP BY card_id\n",
        "HAVING fraud_flags > 0\n",
        "ORDER BY fraud_flags DESC, avg_risk_score DESC\n",
        "LIMIT 20"
      ]
    }
  ],
