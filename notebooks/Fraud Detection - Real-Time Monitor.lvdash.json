{
  "datasets": [
    {
      "name": "1988f3b3",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `fraud_detection`;\n",
        "USE SCHEMA `transactions`;\n",
        "\n",
        "SELECT\n",
        "  COUNT(*)                                          AS total_transactions,\n",
        "  SUM(is_fraud)                                     AS actual_fraud,\n",
        "  SUM(predicted_fraud)                              AS predicted_fraud,\n",
        "  ROUND(SUM(is_fraud) / COUNT(*) * 100, 2)          AS actual_fraud_rate_pct,\n",
        "  ROUND(SUM(predicted_fraud) / COUNT(*) * 100, 2)   AS predicted_fraud_rate_pct,\n",
        "  ROUND(SUM(CASE WHEN predicted_fraud=1 AND is_fraud=1 THEN 1 END) / \n",
        "        NULLIF(SUM(is_fraud), 0) * 100, 2)          AS recall_pct,\n",
        "  ROUND(SUM(CASE WHEN predicted_fraud=1 AND is_fraud=1 THEN 1 END) / \n",
        "        NULLIF(SUM(predicted_fraud), 0) * 100, 2)   AS precision_pct,\n",
        "  ROUND(SUM(CASE WHEN is_fraud=1 THEN amount ELSE 0 END), 2) AS fraud_amount_total\n",
        "FROM fraud_detection.transactions.scored_transactions"
      ]
    },
    {
      "name": "ffe42e28",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `fraud_detection`;\n",
        "USE SCHEMA `transactions`;\n",
        "\n",
        "SELECT\n",
        "  hour_of_day,\n",
        "  COUNT(*)        AS total_txns,\n",
        "  SUM(is_fraud)   AS fraud_count,\n",
        "  ROUND(SUM(is_fraud) / COUNT(*) * 100, 2) AS fraud_rate_pct\n",
        "FROM fraud_detection.transactions.scored_transactions\n",
        "GROUP BY hour_of_day\n",
        "ORDER BY hour_of_day"
      ]
    },
    {
      "name": "3aa8d0f9",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `fraud_detection`;\n",
        "USE SCHEMA `transactions`;\n",
        "\n",
        "SELECT\n",
        "  merchant_category,\n",
        "  COUNT(*)        AS total_txns,\n",
        "  SUM(is_fraud)   AS fraud_count,\n",
        "  ROUND(AVG(fraud_score) * 100, 2) AS avg_fraud_score,\n",
        "  ROUND(SUM(is_fraud) / COUNT(*) * 100, 2) AS fraud_rate_pct\n",
        "FROM fraud_detection.transactions.scored_transactions\n",
        "GROUP BY merchant_category\n",
        "ORDER BY fraud_rate_pct DESC"
      ]
    },
    {
      "name": "57748c75",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `fraud_detection`;\n",
        "USE SCHEMA `transactions`;\n",
        "\n",
        "SELECT\n",
        "  transaction_id,\n",
        "  card_id,\n",
        "  amount,\n",
        "  merchant_category,\n",
        "  entry_mode,\n",
        "  country,\n",
        "  ROUND(fraud_score * 100, 1) AS fraud_score_pct,\n",
        "  alert_level,\n",
        "  timestamp\n",
        "FROM fraud_detection.transactions.fraud_alerts\n",
        "ORDER BY fraud_score DESC\n",
        "LIMIT 50"
      ]
    },
    {
      "name": "3f3178b7",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `fraud_detection`;\n",
        "USE SCHEMA `transactions`;\n",
        "\n",
        "-- Confusion Matrix (great for showing model quality)\n",
        "SELECT\n",
        "    CASE\n",
        "        WHEN is_fraud = 1 AND predicted_fraud = 1 THEN 'True Positive'\n",
        "        WHEN is_fraud = 0 AND predicted_fraud = 1 THEN 'False Positive'\n",
        "        WHEN is_fraud = 1 AND predicted_fraud = 0 THEN 'False Negative'\n",
        "        WHEN is_fraud = 0 AND predicted_fraud = 0 THEN 'True Negative'\n",
        "    END AS classification,\n",
        "    COUNT(*) AS count\n",
        "FROM fraud_detection.transactions.scored_transactions\n",
        "GROUP BY 1\n",
        "ORDER BY 1"
      ]
    },
